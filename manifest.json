{
  "manifest_version": 3,
  "name": "EzyConnector",
  "version": "0.0.1",
  "description": "__MSG_extensionDescription__",
  "default_locale": "vi",
  "permissions": ["storage", "scripting", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  }
}
